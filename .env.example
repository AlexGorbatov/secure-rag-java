# Copy to .env (git-ignored) and fill in. Spring Boot does not read .env by itself:
# export the variables in your shell, IDE run configuration or direnv.

# Default profile — OpenAI
OPENAI_API_KEY=

# Profile "azure" — Azure OpenAI via the unified OpenAI starter
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# JWT issuer and audience (defaults: local Keycloak from compose.yaml)
OAUTH2_ISSUER_URI=http://localhost:8180/realms/securerag
OAUTH2_AUDIENCE=securerag-api

# Token claim locations (defaults: Keycloak). Entra ID: SECURERAG_CLAIMS_ROLES=roles
SECURERAG_CLAIMS_USERNAME=preferred_username
SECURERAG_CLAIMS_GROUPS=groups
SECURERAG_CLAIMS_ROLES=realm_access.roles

# OpenAPI / Swagger UI
OPENAPI_ENABLED=true
OPENAPI_OAUTH_CLIENT_ID=securerag-web
# Swagger UI login endpoints; defaults are derived from OAUTH2_ISSUER_URI (Keycloak layout)
# OPENAPI_AUTHORIZATION_URL=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/authorize
# OPENAPI_TOKEN_URL=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token
